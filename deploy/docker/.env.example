# Replace this with a long random value. Do not commit your real .env file.
PANTRYOS_API_TOKEN=replace-with-long-random-token

# Published host port on the NAS. Home Assistant connects to http://<NAS-LAN-IP>:8765.
PANTRYOS_PORT=8765

# Container listen settings. Keep 0.0.0.0 so other LAN devices can reach the published port.
PANTRYOS_LISTEN_HOST=0.0.0.0
PANTRYOS_LISTEN_PORT=8765

# Persistent state inside the container. The compose file bind-mounts ./data to /data.
PANTRYOS_DATA_DIR=/data
PANTRYOS_BACKUP_DIR=/data/backups
PANTRYOS_DATABASE_PATH=/data/pantryos.sqlite3

PANTRYOS_RATE_LIMIT_REQUESTS=20
PANTRYOS_RATE_LIMIT_WINDOW_SECONDS=60
PANTRYOS_BROWSER_SESSION_SECONDS=43200
PANTRYOS_BROWSER_SECURE_COOKIES=false
