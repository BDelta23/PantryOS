# Copy this to .env or set it in your shell before running Docker Compose.
# Use a long random value for any machine reachable by other devices.
PANTRYOS_API_TOKEN=change-me-local-token
PANTRYOS_PORT=8765
PANTRYOS_RATE_LIMIT_REQUESTS=20
PANTRYOS_RATE_LIMIT_WINDOW_SECONDS=60
PANTRYOS_BROWSER_SESSION_SECONDS=43200
PANTRYOS_BROWSER_SECURE_COOKIES=false
# Optional: set to memory to disable restart-persistent browser sessions.
# PANTRYOS_BROWSER_SESSION_STORE=memory
